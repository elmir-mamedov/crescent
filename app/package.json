{
  "name": "kb-viewer",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "description": "Lean viewer/editor for the markdown knowledge base.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "harvest": "tsx src/harvest/harvest.ts",
    "migrate:ids": "tsx src/migrate-ids.ts",
    "start": "tsx src/server.ts",
    "app:install": "node scripts/install-app.mjs",
    "build:shell": "node scripts/build-shell.mjs",
    "build:release": "node scripts/build-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@elmir-mamedov/feedback": "github:elmir-mamedov/feedback#v0.2.1",
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^4.28.1",
    "highlight.js": "^11.10.0",
    "js-yaml": "^3.15.2",
    "katex": "^0.18.7",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^3.12.10",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
