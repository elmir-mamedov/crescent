# Copy to .env and fill in the three required values; .env is gitignored.
# Read at startup from the repo root, then from app/ — a real environment
# variable always wins over both.

# --- Required. The server refuses to start without these. ----------------
# Browser sign-in. One account, so treat the password like a shared secret.
AUTH_USERNAME=
AUTH_PASSWORD=
# Signs the session cookie. Any long random string will do:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SESSION_SECRET=
# Or turn sign-in off entirely, for a personal install nobody else can reach;
# the three values above are then not needed. Refused unless HOST is loopback.
# AUTH_DISABLED=1

# --- Optional. Shown with their defaults. --------------------------------
# Where the knowledge base lives.
# KB_DIR=../kb
# PORT=4000
# Loopback only. Read the Run section of app/README.md before widening this.
# HOST=localhost
# SITE_TITLE=Knowledge Base

# Believe x-forwarded-proto and x-forwarded-for. Set this only when a reverse
# proxy really is in front: unproxied, a caller writes those headers itself.
# TRUST_PROXY=1

# Multi-machine sync: rebase and push each kb/<space> repo to its own remote
# after every auto-commit. Off unless set, and silent when a push fails.
# KB_SYNC=1
# KB_SYNC_DEBOUNCE_MS=5000
# KB_SYNC_TIMEOUT_MS=20000
